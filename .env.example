# Copy to .env at the repo root: cp .env.example .env
# One file serves the backend, the scripts and the frontend (Vite reads it via envDir).
# Never commit .env.

# ---------- Backend ----------
# Postgres + TimescaleDB connection string (default matches docker-compose.yml). Production: Tiger Data's
# string ending in ?sslmode=require. Check any string with: python scripts/check_db.py
DATABASE_URL=postgresql://luminest:luminest@localhost:5432/luminestbc
# Comma-separated browser origins allowed to call the API and open sockets
FRONTEND_ORIGIN=http://localhost:5173
# Public URL of this backend (your ngrok URL when testing calls); Twilio signatures and <Play> audio links use it
BACKEND_PUBLIC_URL=http://localhost:8000
# Port for `python run.py` (Render sets PORT itself)
PORT=8000
# Max pooled DB connections (keep under your Tiger Data plan's connection limit)
DB_POOL_MAX_SIZE=20
# Apply backend/sql/schema.sql (idempotent) when the server starts
AUTO_MIGRATE=true
# true = text shelters whose count is over 3 hours old (Tier 2 stub, off by default)
SMS_NUDGE_ENABLED=false

# ---------- Communications (Tier 2) ----------
# Twilio account SID from console.twilio.com
TWILIO_ACCOUNT_SID=
# Twilio auth token (also used to validate webhook signatures)
TWILIO_AUTH_TOKEN=
# The Twilio phone number for the voice line, in E.164 format (+1604...)
TWILIO_PHONE_NUMBER=
# Google AI Studio key for Gemini structured extraction
GEMINI_API_KEY=
# ElevenLabs key for text-to-speech
ELEVENLABS_API_KEY=
# ElevenLabs voice to speak with
ELEVENLABS_VOICE_ID=
# ElevenLabs model; eleven_flash_v2_5 is the low-latency one (best for phone calls)
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---------- Admin / test hub ----------
# true = enable /admin, the voice + SMS simulators and admin access to staff portals. Every admin
# endpoint also needs ADMIN_KEY (403 without it) and is rate limited; production keeps it on for the demo
DEV_TOOLS_ENABLED=true
# Secret for /admin (entered once in the browser). Long and random, e.g. python -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_KEY=

# ---------- Scripts ----------
# Base URL for NFC tag links and staff-portal links (generate_tag_links.py and tag rotation in the portal).
# Production: https://lumi-nest-bc.vercel.app (or https://luminestbc.tech once the domain points at Vercel).
# Set it to your ngrok URL when testing on real phones.
TAG_BASE_URL=https://lumi-nest-bc.vercel.app
# Teammate's phone (e.g. +16045550123) that scripts/import_shelters.py sets as staff_phone for the
# demo shelters (shelter-01, shelter-20) so the staff SMS demo works. Real shelters never get one.
# Keep real numbers here in .env only, never in the repo. Empty = no shelter can update by SMS.
DEMO_STAFF_PHONE=

# ---------- Frontend ----------
# Backend URL the browser calls. Leave empty in local dev (Vite proxies /api and /socket.io).
VITE_API_URL=
# Free CARTO key, only used for Voyager raster tiles if OpenFreeMap vector tiles are unreachable. Empty = OSM tiles
VITE_CARTO_KEY=
# Google Street View Static API browser key for shelter photos (restrict by HTTP referrer). Empty = icon tiles
VITE_GOOGLE_MAPS_KEY=
# Where the Vite dev proxy forwards /api and /socket.io
BACKEND_DEV_URL=http://localhost:8000

# ---------- Tests ----------
# Separate database for pytest; created and wiped automatically
TEST_DATABASE_URL=postgresql://luminest:luminest@localhost:5432/luminestbc_test
